# App
NEXT_PUBLIC_APP_NAME=Open Order
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudflare Workers AI is unused unless OPEN_ORDER_ALLOW_NON_GEMINI=1.
# CLOUDFLARE_DISABLE_THINKING=0 turns Gemma thinking back on. Any other value, including unset, leaves it off.
# CLOUDFLARE_JSON_TIMEOUT_MS defaults to 30000. CLOUDFLARE_DRAFT_TIMEOUT_MS defaults to 75000.
# Both timeouts are clamped to 10000-120000, and each call is also capped by the time left in the 270s request.
# CLOUDFLARE_ANSWER_MAX_TOKENS defaults to 2000.